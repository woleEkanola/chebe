// Prisma schema for Chebe Parent Web backend (local Postgres, poll-only sync).
// Clients (web UI, ChebeService.exe) poll REST every 15–30s. No push infra in v1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Family {
  id        String   @id @default(cuid())
  name      String   @default("My Family")
  createdAt DateTime @default(now())
  users     User[]
  children  Child[]
  geofences Geofence[]
  alerts    Alert[]
  pairing   PairingCode[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Parent")
  familyId     String
  family       Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
}

model Child {
  id       String  @id @default(cuid())
  name     String
  age      Int
  familyId String
  family   Family  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  devices  Device[]
  limits   AppLimit[]
  alerts   Alert[]
  locations Location[]
  usage    UsageDaily[]
  createdAt DateTime @default(now())
}

model Device {
  id            String   @id @default(cuid())
  childId       String
  child         Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  platform      String   @default("windows") // windows | android | ios
  label         String   @default("Device")
  policyVersion Int      @default(1)
  instantPaused Boolean  @default(false)
  lastSeenAt    DateTime?
  createdAt     DateTime @default(now())
  schedules     Schedule[]
}

model Schedule {
  id          String  @id @default(cuid())
  deviceId    String
  device      Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  label       String  // Bedtime | School | Homework
  days        Int[]   // 0=Mon..6=Sun
  start       String  // "21:00"
  end         String  // "07:00"
  shieldLevel String  @default("full")
  enabled     Boolean @default(true)
}

model AppLimit {
  id        String @id @default(cuid())
  childId   String
  child     Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
  pkg       String // exe on Windows, package on Android
  label     String
  limitMins Int
  @@unique([childId, pkg])
}

model UsageDaily {
  id      String @id @default(cuid())
  childId String
  child   Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
  pkg     String
  day     String // YYYY-MM-DD
  mins    Int    @default(0)
  @@unique([childId, pkg, day])
}

model Alert {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childId   String?
  child     Child?   @relation(fields: [childId], references: [id], onDelete: SetNull)
  severity  String   // high | medium | low
  kind      String   // bullying | stranger | webblock | geofence | sos | pause
  title     String
  detail    String   @default("")
  snippet   String?  // redacted excerpt only — never full content
  guidance  String   @default("")
  status    String   @default("open") // open | reviewed | resolved
  createdAt DateTime @default(now())
}

model Location {
  id         String   @id @default(cuid())
  childId    String
  child      Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  accuracyM  Float    @default(10)
  recordedAt DateTime @default(now())
}

model Geofence {
  id       String @id @default(cuid())
  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  label    String // Home | School
  lat      Float
  lng      Float
  radiusM  Int    @default(200)
}

model PairingCode {
  id        String    @id @default(cuid())
  code      String    @unique // 6 digits, e.g. 482913
  familyId  String
  family    Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childId   String?
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime  @default(now())
}

model WebFilter {
  id        String   @id @default(cuid())
  familyId  String   @unique
  version   Int      @default(1)
  blocklist String[] @default(["gamble-arcade.example", "adult-example.test"])
  whitelist String[] @default([])
  updatedAt DateTime @updatedAt
}
